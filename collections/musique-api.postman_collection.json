      "name": "Artists",
      "item": [
        {
          "name": "Create Artist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Daft Punk\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/artists",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "artists"
              ]
            }
          }
        },
        {
